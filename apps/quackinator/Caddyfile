quackinator.ducksmanager.net {
    reverse_proxy quackinator-app
}

api.quackinator.ducksmanager.net {
    # POST only in both limits: the browser's CORS preflight must not count.

    # Page analysis runs Kumiko and PaddleOCR, which are shared with Dumili.
    @analyze {
        method POST
        path /api/analyze
    }
    route @analyze {
        rate_limit {
            zone quackinator_analyze {
                key {remote_host}
                events 10
                window 1m
            }
        }
    }

    # The API keeps a bounded number of sessions and drops the least recently
    # used, so unlimited starts would end other readers' games. Dumili starts
    # its sessions from dumili-api, which doesn't go through Caddy.
    @start_session {
        method POST
        path /api/sessions
    }
    route @start_session {
        rate_limit {
            zone quackinator_sessions {
                key {remote_host}
                events 10
                window 1m
            }
        }
    }

    @sessions path /api/sessions /api/sessions/*
    request_body @sessions {
        max_size 1MB
    }

    # Without the CORS header the browser hides this response from the page.
    handle_errors 429 {
        header Access-Control-Allow-Origin https://quackinator.ducksmanager.net
        respond "Too many requests, try again in a minute" 429
    }
    reverse_proxy quackinator-api:8000
}
