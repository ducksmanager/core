# Inducks MariaDB source of truth
QUACKINATOR_DB_HOST=localhost
QUACKINATOR_DB_PORT=64999
QUACKINATOR_DB_USER=root
QUACKINATOR_DB_PASSWORD=changeme
QUACKINATOR_DB_NAME=coa

# Where the built index artifacts live
QUACKINATOR_INDEX_DIR=data/index

# Language for descriptions, character names and language names
QUACKINATOR_DESC_LANGUAGE=en

# Link "Does X appear in the story?" to the character's page on inducks.org,
# for a reader who does not recognise the name.
QUACKINATOR_INDUCKS_CHARACTER_LINK=true

# Root of the scan mirror shown beside each guess. Inducks records the path of
# every scan and nothing about who serves it: the paths are baked into the index
# and this is the half that moves, so re-pointing the mirror or retuning the
# transformation needs no rebuild.
#
# Our own Cloudinary copy of the tree, and not outducks.org, which the dump
# points at and which answers 404 for every scan path (checked 2026-09-02). The
# leading segment is a Cloudinary transformation, and it is load-bearing: the
# originals behind it are full pages of 40-250 KB, and it crops them to the top
# of the page at twice the rendered size, ~6 KB each.
#
# Leave it empty to show no pictures at all: rows then fall back to the title,
# which is also what happens for the 5% of stories nobody has scanned.
#
# NOTE (2026-09-02): the mirror fetches on first request, and that fetch is
# failing — an uncached path answers 400, "Timed out connecting to server". Its
# cover scans are cached and fine; most story first pages are not yet, so most
# rows fall back to the title until the upstream behind it is reachable.
QUACKINATOR_THUMBNAIL_BASE=https://res.cloudinary.com/dl7hskxab/image/upload/c_fill,g_north,w_92,h_124,f_auto,q_auto/inducks-covers/

# Probability that a reader answers a question wrongly. Keep this non-zero:
# readers miscount pages and miss background characters, and a hard filter would
# eliminate the true story permanently. Keep it low, too — raising it to absorb
# an unreliable reader does not help against one (against a reader who lies on
# 15% of answers, a high floor is worse than a low one) and costs about half of
# top-1 accuracy against an honest one.
QUACKINATOR_NOISE_FLOOR=0.05

# Probability that the layout Inducks records for a storyversion is not the
# layout of the printing in the reader's hands. Inducks does not mint a new
# storyversion for every re-layout and inducks_entry has no layout columns, so
# this cannot be measured from the dump. Tune it with
# `simulate.py --layout-mismatch-rate`, not against the default reader.
QUACKINATOR_LAYOUT_MISMATCH=0.10

# P("yes") for a character cell Inducks records but the reader cannot check: a
# cameo in one background panel, a character present only as a photo or a
# statue, or a one-time character indexers are not required to list. Neutral by
# default — the claim these cells support is that they are not evidence, not
# that they lean one way. Moving it off 0.5 asserts a direction; check
# `mise run sim`.
QUACKINATOR_CHAR_WEAK_EVIDENCE=0.5

# Same, for the decade printed on the cover — and deliberately NOT raised to
# absorb Inducks' missing issues, even though 27% of readers name a decade the
# index has no record of for their story. Raising it to 0.45 gives up 11x the
# information to recover 17% of the median rank for exactly those readers, and
# makes their p90 worse. Slack cannot help here: an unindexed magazine leaves no
# trace, so it lifts the true story and every rival together.
# QUACKINATOR_DECADE_IMPOSSIBLE is what actually protects that reader.
QUACKINATOR_DECADE_NOISE=0.05

# P(the reader's magazine is dated before its story was first published). Not a
# reader error but an error in inducks_story.firstpublicationdate, which
# disagrees with the recorded printings on 0.02% of rows.
QUACKINATOR_DECADE_IMPOSSIBLE=0.002

# Longest decade list to show. Above the number of decades on purpose, so the
# chronological list is never condensed — condensing it would keep the earliest
# decades rather than the likeliest.
QUACKINATOR_DECADE_OPTIONS=16

# Longest answer list to show. Language gets its own, longer cap: a reader scans
# it for the one answer they are certain of instead of weighing the options.
QUACKINATOR_MAX_OPTIONS=8

# Allowed origins for the Vue dev server
QUACKINATOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8004","http://127.0.0.1:8004"]
